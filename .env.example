# ============================================================
#  Universal Media Downloader Bot - Environment Variables
#  Copy this file to .env and fill in your values:
#      cp .env.example .env
# ============================================================

# --- REQUIRED ---
# Get your bot token from @BotFather on Telegram
BOT_TOKEN=8893611617:AAFrfRaaAmqbshJYlud37Iu40s1ounSuPQQ

# --- PROXY SETTINGS (Essential for Iran / restricted networks) ---
# HTTP/HTTPS proxy for Telegram API communication
# Format: http://user:pass@host:port or socks5://user:pass@host:port
PROXY_HTTP=
PROXY_HTTPS=

# Separate proxy for yt-dlp downloads (can be different from Telegram proxy)
# Format: socks5://127.0.0.1:1080 or http://127.0.0.1:8080
YTDLP_PROXY=

# --- COOKIE FILE ---
# Path to Netscape-format cookies.txt (for private Instagram, age-restricted YouTube, etc.)
# Export using browser extension "Get cookies.txt LOCALLY"
COOKIE_FILE=cookies.txt

# --- LIMITS ---
# Maximum file size in MB that the bot will send (Telegram bot limit is 50MB)
MAX_FILE_SIZE_MB=50

# Rate limiting: max requests per time window
MAX_REQUESTS_PER_WINDOW=5
RATE_LIMIT_WINDOW=30

# --- PATHS ---
# Directory where temporary downloads are stored
DOWNLOAD_DIR=~/downloads
